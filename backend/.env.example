APP_NAME=知枢星图
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

DATABASE_URL=sqlite:///./data/knowledge.db

JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# DeepSeek 官方通道（Agentic RAG M1，thinking 显式关闭）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# M2 评估独立裁判（默认智谱 GLM-5.3-Flash；JUDGE_PROVIDER=qwen 可回退千问）
JUDGE_PROVIDER=glm
GLM_API_KEY=your-zhipu-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_JUDGE_MODEL=glm-5.3-flash
QWEN_JUDGE_MODEL=qwen3.7-max-2026-06-08

# M2: Langfuse 可观测（fail-silent，key 缺失不影响主流程）
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TIMEOUT=5

# M3: MCP Server 认证（挂载于 /mcp，Claude Desktop / Cursor 连接用；为空则拒绝所有 MCP 请求）
MCP_API_KEY=your-mcp-api-key
# Phase 4: MCP 权限分级（默认只读；写操作需显式开启，且必须绑定写入用户）
MCP_ENABLE_WRITE=false
MCP_DRY_RUN=true
MCP_WRITE_USER_ID=

# M3-2: web_search 联网搜索（Tavily，https://tavily.com 免费注册；为空则工具优雅降级）
TAVILY_API_KEY=tvly-xxx

EMBEDDING_MODEL=all-MiniLM-L6-v2

FAISS_INDEX_PATH=./data/faiss_index

# LangChain 功能开关（渐进式迁移）
# 逐步开启以验证 LangChain 实现，默认全部关闭使用原有实现
USE_LANGCHAIN_EMBEDDINGS=false
USE_LANGCHAIN_VECTORSTORE=false
USE_LANGCHAIN_PROMPT=false
USE_LANGCHAIN_RAG=false
USE_LANGCHAIN_CHAT=false
USE_LANGCHAIN_SKILL=false

# M4: LangGraph 记忆 / HITL
USE_VECTOR_MEMORY=false
AGENT_MAX_ITERATIONS=8
AGENT_TOKEN_BUDGET=10000
AGENT_MAX_HISTORY_MESSAGES=24
AGENT_CHECKPOINT_DB=./data/langgraph_checkpoints.db
# 单会话双预算(硬截断):token 与金额任一超限即停
AGENT_SESSION_TOKEN_BUDGET=200000
AGENT_SESSION_COST_BUDGET_CNY=1.0
# 成本估算单价(元/千 token):运行时与 eval 共用,只作趋势参考,不作结算依据
AGENT_COST_PER_1K_TOKENS_CNY=0.002

# Phase 5: GraphRAG-lite（双向链接 1 跳邻居扩展 + RRF；关掉即恢复纯混合检索）
GRAPH_RAG_ENABLED=true
GRAPH_RAG_NEIGHBOR_LIMIT=5
GRAPH_RAG_NEIGHBOR_WEIGHT=0.5
